# =============================================================
# PAPER TRADING BOT - ORTAM KONFIGURASYONU (ornek dosya)
# Bu dosyayi ".env" adina kopyalayip degerleri doldurun.
# DIKKAT: Gercek cuzdan ozel anahtari (private key) HICBIR
#         yere yazilmaz. Bot tamamen simulasyon modunda calisir.
# =============================================================

# --- Simulasyon hesabi ---
# Paper trading baslangic bakiyesi (USD)
PAPER_STARTING_BALANCE=10000.0

# --- Veri kaynagi: Jupiter Aggregator API (ucretsiz, anahtar gerektirmez) ---
JUPITER_PRICE_API_URL=https://api.jup.ag/price/v3
JUPITER_TOKENS_API_URL=https://api.jup.ag/tokens/v2
JUPITER_SWAP_API_URL=https://api.jup.ag/swap/v1

# --- Solana RPC dugumu (salt-okur fiyat/dogrulama icin; opsiyonel) ---
# Ucretsiz public node: https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Tarama parametreleri ---
# Her turlu kac saniyede bir fiyat guncellemesi yapilsin
SCAN_INTERVAL_SECONDS=30
# Bir token kac saniye icinde yeniden fiyatlandirilmali (bayatlik esigi)
QUOTE_MAX_AGE_SECONDS=90
# Alim icin aday havuzu buyuklugu (Market Cap'e gore siralanmis on listeler)
CANDIDATE_POOL_SIZE=50

# --- Risk yonetimi ---
# Market Cap su degerin altindaki memecoin'ler ATLANIR (USD)
MIN_MARKET_CAP_USD=20000.0
# Tek bir pozisyon icin ayrilacak maks. sermaye yuzdesi
MAX_POSITION_PCT=5.0
# Fiyat bu yuzde dustugunde tam kapanis (Stop-Loss)
STOP_LOSS_PCT=15.0
# Fiyat bu katliga ulasinda pozisyonun yarisi satilir (Take-Profit)
TAKE_PROFIT_MULTIPLIER=2.0
# Take-Profit sonrasi kalan coin icin tepeden bu yuzde dusurse kapatilir
TRAILING_STOP_PCT=20.0

# --- Islem maliyeti modeli (simulasyon) ---
# Jupiter tahmini yol maliyeti + slippage bilestirmesi (%)
SIMULATED_SLIPPAGE_PCT=0.5
# Her islem icin sabit gas sabitleme payi (USD)
SIMULATED_GAS_FEE_USD=0.01

# --- Log seviyesi: DEBUG / INFO / WARNING / ERROR ---
LOG_LEVEL=INFO
